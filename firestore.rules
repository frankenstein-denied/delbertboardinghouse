rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    // users/{uid} — one profile doc per resident.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'resident';
      // Role and uid are immutable after creation — otherwise any resident
      // could self-promote to admin and read every private report.
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // posts/{postId} — freedom-wall feed posts, 24h TTL via `expiresAt`.
    match /posts/{postId} {
      allow read: if isSignedIn();
      // `expiresAt` bound is checked against request.time (the server's
      // clock), not the client's — the client writes
      // Timestamp.fromMillis(Date.now() + 24h), but a rule can only trust
      // its own server-side clock, with slack for client clock skew and
      // function-execution latency. Without this bound, a resident could
      // set expiresAt arbitrarily far in the future (defeating the "gone
      // after 24h" guarantee) or omit it entirely (invisible to the app's
      // own filtered queries AND to Firestore's TTL sweep — an
      // unreclaimable storage leak).
      //
      // Denormalized identity fields are validated against the caller's own
      // profile doc — authorId == request.auth.uid alone only proves *who
      // is writing*, not that the displayed name/program/room/initials are
      // theirs. Without this, any signed-in resident could post under
      // someone else's displayed identity via a raw SDK call (the app's own
      // UI never offers this, but the UI isn't the security boundary).
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.authorProgram == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.program
        && request.resource.data.authorRoom == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.room
        && request.resource.data.authorInitials == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.initials
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000 + 300000;
      // No edit/delete UI exists for a post's own content — the only
      // client mutation is toggling your own reaction inside the map.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // reports/{reportId} — private: author + admin only. 24h TTL via `expiresAt`.
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      // Same expiresAt server-clock bound as posts/create above.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000 + 300000;
      allow update, delete: if false;
    }

    // conversations/{id} — id is the two participant uids, sorted and joined with "_".
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // participantNames[caller's own uid] is validated against the
      // caller's own profile doc, for the same impersonation reason as
      // posts/create above — the creator otherwise fully controls what
      // display name the OTHER participant sees for them in their inbox.
      // NOTE: the *other* participant's participantNames entry is NOT
      // verified here — this rule has no permission to assert what someone
      // else's profile says at create time, since get() can only read, and
      // there's no way to require the other uid's name without trusting
      // either the creator's claim or a second identity's signature that
      // doesn't exist in this data model. That entry is trusted from the
      // creator as an accepted residual gap, not solved by this rules pass.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantNames[request.auth.uid]
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
      // participantIds is immutable after creation — without this, either
      // participant could rewrite it to add a third party or drop the other
      // person, retroactively exposing (or locking someone out of) the
      // entire prior message history via the messages subcollection's own
      // rules below, which trust this document's *current* participantIds.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      // messages/{messageId} — 4h TTL via `expiresAt`.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Same expiresAt server-clock bound reasoning as posts/reports
        // create above, scaled to the 4h message TTL.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 4 * 60 * 60 * 1000 + 300000;
        allow update, delete: if false;
      }
    }

    // friendRequests/{id} — id is "${fromUid}_${toUid}". No `friends` array
    // anywhere: friendship is derived by querying accepted requests in both
    // directions, because writing to another user's document is never
    // allowed by these rules (see plan's Global Constraints).
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the recipient can accept/ignore; identities can't be swapped in
      // the same write. resource.data.status == 'pending' makes the
      // pending→terminal transition a one-shot: without it, the recipient
      // could keep toggling an already-accepted/ignored request back and
      // forth indefinitely.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ['accepted', 'ignored'];
      allow delete: if false;
    }
  }
}
