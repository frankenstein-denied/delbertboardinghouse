rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} — one profile doc per resident.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid;
      // uid is immutable after creation — otherwise a resident could rewrite
      // their profile doc's uid to impersonate another resident's identity
      // in every place that trusts this field (posts, reports, messages).
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid;
      // Residents can only ever delete their own profile doc.
      allow delete: if isSelf(uid);
    }

    // posts/{postId} — freedom-wall feed posts, 24h TTL via `expiresAt`.
    match /posts/{postId} {
      allow read: if isSignedIn();
      // `expiresAt` bound is checked against request.time (the server's
      // clock), not the client's — the client writes
      // Timestamp.fromMillis(Date.now() + 24h), but a rule can only trust
      // its own server-side clock, with slack for client clock skew and
      // function-execution latency. Without this bound, a resident could
      // set expiresAt arbitrarily far in the future (defeating the "gone
      // after 24h" guarantee) or omit it entirely (invisible to the app's
      // own filtered queries AND to Firestore's TTL sweep — an
      // unreclaimable storage leak).
      //
      // Denormalized identity fields are validated against the caller's own
      // profile doc — authorId == request.auth.uid alone only proves *who
      // is writing*, not that the displayed name/program/residentType/initials are
      // theirs. Without this, any signed-in resident could post under
      // someone else's displayed identity via a raw SDK call (the app's own
      // UI never offers this, but the UI isn't the security boundary).
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.authorProgram == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.program
        && request.resource.data.authorResidentType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.residentType
        && request.resource.data.authorInitials == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.initials
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000 + 300000;
      // No edit/delete UI exists for a post's own content — the only
      // client mutation is toggling your own reaction inside the map.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]);
      // Only the author can delete their own post.
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // comments/{commentId} — 24h TTL via `expiresAt`, mirrors the post's
      // own TTL window. Firestore has no cascading delete, so a comment can
      // briefly outlive a deleted parent post until its own TTL sweep runs —
      // accepted residual, matching this data model's existing no-cascade
      // posture elsewhere (e.g. messages after a conversation).
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.authorInitials == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.initials
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000 + 300000;
        allow update, delete: if false;
      }
    }

    // reports/{reportId} — public, anonymous — readable by any signed-in
    // resident; `authorId` stays in the doc only to prove ownership on
    // create, the UI never displays it. 24h TTL via `expiresAt`.
    match /reports/{reportId} {
      allow read: if isSignedIn();
      // Same expiresAt server-clock bound as posts/create above.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000 + 300000;
      allow update, delete: if false;
    }

    // conversations/{id} — id is the two participant uids, sorted and joined with "_".
    match /conversations/{conversationId} {
      // `resource == null` short-circuit is required for the "does this
      // conversation already exist?" getDoc() check in startConversationWith
      // (chats-view.tsx) to work at all: Firestore's rules engine sets
      // `resource` to null for a document that doesn't exist yet, and
      // evaluating `resource.data.participantIds` on a null resource throws
      // a rules-evaluation error — which Firestore treats as a DENIED read,
      // not as "not found." Without this clause, getDoc() on a brand-new
      // conversation id rejects with permission-denied instead of resolving
      // to a snapshot with .exists() === false, so the whole "start a new
      // chat" flow silently breaks (the unhandled rejection stops execution
      // before setSelectedId/setStarting ever run). Allowing the read when
      // resource is null is safe: there is no data to leak from a document
      // that doesn't exist, it just resolves to "not found" as intended.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      // participantNames[caller's own uid] is validated against the
      // caller's own profile doc, for the same impersonation reason as
      // posts/create above — the creator otherwise fully controls what
      // display name the OTHER participant sees for them in their inbox.
      // NOTE: the *other* participant's participantNames entry is NOT
      // verified here — this rule has no permission to assert what someone
      // else's profile says at create time, since get() can only read, and
      // there's no way to require the other uid's name without trusting
      // either the creator's claim or a second identity's signature that
      // doesn't exist in this data model. That entry is trusted from the
      // creator as an accepted residual gap, not solved by this rules pass.
      // lastMessage/lastReadAt are pinned to their legitimate initial
      // values here too — without this, a raw-SDK creator could forge
      // lastReadAt with the OTHER participant's uid pre-populated (e.g. a
      // far-future timestamp), permanently suppressing that victim's unread
      // badge for this thread and defeating the whole point of this feature.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantNames[request.auth.uid]
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastReadAt == {};
      // participantIds is immutable after creation — without this, either
      // participant could rewrite it to add a third party or drop the other
      // person, retroactively exposing (or locking someone out of) the
      // entire prior message history via the messages subcollection's own
      // rules below, which trust this document's *current* participantIds.
      //
      // Only lastMessage/lastMessageAt/lastReadAt may ever change after
      // creation (participantNames is frozen too, tightening a latent gap
      // noticed while adding this rule — nothing legitimate needs to change
      // it post-creation). lastReadAt updates are further scoped to the
      // caller's own key in that map, the same map-diff pattern as
      // posts/reactions above, so a participant can only ever mark THEIR OWN
      // read cursor, never spoof the other side's.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastReadAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAt'])
          || request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
        );
      allow delete: if false;

      // messages/{messageId} — 4h TTL via `expiresAt`.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Same expiresAt server-clock bound reasoning as posts/reports
        // create above, scaled to the 4h message TTL.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt.toMillis() <= request.time.toMillis() + 4 * 60 * 60 * 1000 + 300000;
        allow update, delete: if false;
      }
    }

    // friendRequests/{id} — id is "${fromUid}_${toUid}". No `friends` array
    // anywhere: friendship is derived by querying accepted requests in both
    // directions, because writing to another user's document is never
    // allowed by these rules (see plan's Global Constraints).
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the recipient can accept/ignore; identities can't be swapped in
      // the same write. resource.data.status == 'pending' makes the
      // pending→terminal transition a one-shot: without it, the recipient
      // could keep toggling an already-accepted/ignored request back and
      // forth indefinitely.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ['accepted', 'ignored'];
      // Either party in an ACCEPTED request can delete it to unfriend — this is
      // the only "friends" relationship this data model has (no separate
      // friends array anywhere, see the match block's own top comment), so
      // removing the request doc removes the friendship for both sides at once.
      // Only accepted requests are deletable this way — a pending request the
      // recipient doesn't want is handled by the existing 'ignored' status
      // transition instead, not deletion.
      allow delete: if isSignedIn()
        && resource.data.status == 'accepted'
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }
  }
}
